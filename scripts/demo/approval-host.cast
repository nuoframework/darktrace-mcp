[0.16137, "o", "\u001b[2J\u001b[H\u001b[1;36mDARKTRACE MCP  /  03 / PREVIEW FIRST\u001b[0m\r\n\u001b[2mSynthetic local appliance • no production data\u001b[0m\r\n\r\nCritical action • read,write,critical profiles • default elicitation\r\n\r\n"]
[0.161404, "o", "1. Preview Antigena action: dryRun:true\r\n{\"codeid\":1,\"activate\":true,\"duration\":60,\"reason\":\"Synthetic demo - decline this action\"}\r\n"]
[0.167274, "o", "\r\n"]
[0.167289, "o", "previewId: c59b17a2b09cf282278eaf6a76e1be68\r\nSingle-use • valid for 5 minutes\r\n"]
[3.168689, "o", "\r\n"]
[3.16872, "o", "2. Repeat the same action: confirm:true + previewId\r\n"]
[3.168753, "o", "   The server now asks the host for human approval.\r\n"]
[5.678786, "o", "\u001b[2J\u001b[H\u001b[1;36mDARKTRACE MCP  /  03 / HUMAN APPROVAL\u001b[0m\r\n\u001b[2mSynthetic local appliance • no production data\u001b[0m\r\n\r\nConfirmation dialog • demo MCP host (not a client screenshot)\r\n\r\nDarktrace CRITICAL action requested by the AI assistant.\r\n"]
[5.678815, "o", "Operation: post_antigena (POST /antigena)\r\n  argsHash = 9e9f828517332a9decd6072f289837ca0d967635a6132481f6c8089266d465f9\r\n"]
[5.678857, "o", "  body.codeid = 1\r\n  body.activate = true\r\n"]
[5.678864, "o", "  body.reason = \"Synthetic demo - decline this action\"\r\n"]
[5.678892, "o", "  body.duration = 60\r\nApprove only if you intended this exact action. Decline to cancel; nothing is sent unless\r\n"]
[5.6789, "o", "you accept.\r\n"]
[5.678923, "o", "\r\nRequired field: approved (boolean)\r\n\r\n"]
[5.679642, "o", "\u001b[1G"]
[5.679671, "o", "\u001b[0J"]
[5.679682, "o", "[ Accept ]  [ Decline ]  → Press Enter to DECLINE: "]
[5.679737, "o", "\u001b[52G"]
[9.685655, "o", "\r\r\n"]
[9.688971, "o", "\r\n"]
[9.68898, "o", "\u001b[33m3. Declined → {\"error\":{\"code\":\"approval_denied\",\"message\":\"Human approval was not\r\n"]
[9.689012, "o", "granted.\"},\"errorCode\":\"approval_denied\",\"hint\":\"Not executed: the user did not approve.\r\n"]
[9.689015, "o", "Do not retry unless the user explicitly asks again.\"}\u001b[0m\r\n"]
[9.68905, "o", "\r\nNo action executed. Preview and refusal audited on stderr.\r\n"]
