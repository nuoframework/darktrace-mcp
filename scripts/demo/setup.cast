[5.3851, "o", "\r\r\n"]
[5.385771, "o", "\r\nHow should clients start the server?\r\n  1) node (this checkout)  [default]\r\n  2) docker (reviewed image ID)\r\n"]
[5.385779, "o", "\u001b[1G\u001b[0JChoice [1]: "]
[5.38578, "o", "\u001b[13G"]
[5.932695, "o", "1"]
[5.979712, "o", "\r\r\n"]
[5.980074, "o", "\r\n"]
[5.980115, "o", "Create API tokens in Darktrace: System Config > Settings > API Token. Input stays hidden.\r\n"]
[5.980142, "o", "\u001b[1G\u001b[0JPublic token: "]
[5.980144, "o", "\u001b[15G"]
[7.520629, "o", "\r\n"]
