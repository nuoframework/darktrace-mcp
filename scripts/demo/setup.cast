[5.605825, "o", "\r\r\n"]
[5.606011, "o", "\r\r\nWhich capabilities should the AI client get?\r\r\n"]
[5.606143, "o", "  1) read: consultation only, no raw content (recommended)\r\r\n  2) read + write: also acknowledge, comment, tag, label, PCAP requests\r\r\n  3) read + sensitive: also Advanced Search, email content, PCAP download, audit events\r\r\n  4) all: read, sensitive, write and critical (requires the risk acknowledgement below)\r\r\n"]
