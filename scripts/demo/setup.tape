Output docs/assets/demo/setup.gif
Require node
Require asciinema
Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 18
Set Width 1120
Set Height 690
Set Padding 20
Set Theme "GitHub Dark"
Set TypingSpeed 45ms
Set Framerate 30
Hide
Type "bash scripts/demo/terminal.sh"
Enter
Sleep 1s
Type "clear"
Enter
Sleep 200ms
Show
Type "node dist/src/index.js setup"
Sleep 400ms
Enter
Sleep 600ms
Type "https://192.168.0.111:8444"
Sleep 300ms
Enter
Sleep 500ms
Type "1"
Enter
Sleep 700ms
Type "mock-public-token"
Enter
Sleep 400ms
Type "mock-private-token"
Enter
Sleep 900ms
Type "1"
Enter
Sleep 1500ms
Type "opencode"
Sleep 350ms
Enter
Sleep 5s
Hide
Type "exit"
Enter
Sleep 500ms
