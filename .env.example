# Reference only: the server does not automatically load dotenv files.
# Node --env-file loads before the server; the server does not validate that file.
# NODE_OPTIONS preloads execute before server checks; NODE_EXTRA_CA_CERTS extends TLS trust.
# Review both in the trusted launcher before startup. The env file is executable trust configuration, not a sandbox.
# JSON/token ownership, permissions, no-follow and size checks do not apply to env files.
# If used, protect externally: operator-owned 0600, trusted non-symlink location.
# Only non-secret settings/token-file paths; never put token values in an env file.
# Provision token files outside this repository; no token values belong here.
DARKTRACE_URL=https://darktrace.example.internal
DARKTRACE_PUBLIC_TOKEN_FILE=/absolute/private/darktrace/public-token
DARKTRACE_PRIVATE_TOKEN_FILE=/absolute/private/darktrace/private-token
DARKTRACE_PROFILES=read
DARKTRACE_SENSITIVE_READ=false
# Optional approved private CA: Node reads this trust extension at startup.
# NODE_EXTRA_CA_CERTS=/absolute/private/ca.pem
