{
  "name": "@nuoframework/darktrace-mcp",
  "version": "1.1.0",
  "mcpName": "io.github.nuoframework/darktrace-mcp",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "darktrace-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.json",
    "README.md",
    "README.es.md",
    "LICENSE",
    "SECURITY.md",
    "npm-shrinkwrap.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "generate": "tsc -p tsconfig.generate.json && node dist/scripts/generate-catalogue.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "start": "node dist/src/index.js",
    "test:security": "node test/security/run-isolated.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "docs:tools": "node scripts/generate-tools-doc.mjs",
    "pack:mcpb": "node scripts/build-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "24.0.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "description": "Stdio MCP server for the Darktrace Threat Visualizer API (unofficial)",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "darktrace",
    "threat-visualizer",
    "security",
    "soc"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuoframework/darktrace-mcp.git"
  },
  "homepage": "https://github.com/nuoframework/darktrace-mcp#readme",
  "bugs": {
    "url": "https://github.com/nuoframework/darktrace-mcp/issues"
  }
}
